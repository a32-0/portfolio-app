# --- Chatbot (app/api/chat) ---

# anthropic | openai | google. Only the active provider's key is required.
CHAT_PROVIDER=anthropic

# console.anthropic.com — set a spend limit on the key there.
ANTHROPIC_API_KEY=

# platform.openai.com
OPENAI_API_KEY=

# aistudio.google.com
GEMINI_API_KEY=

# upstash.com (free tier) — per-visitor rate limit. From the database's REST API section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
